{
  "config_version": 1,
  "targets": {
    "ctx-aide-source": {
      "paths": [
        "docs",
        "scripts",
        "skills",
        "tools"
      ],
      "line_kind": "nonblank_lines",
      "min_lines": 1000,
      "max_lines": 50000
    },
    "ctx-aide-cli": {
      "paths": [
        "tools/ctx-aide"
      ],
      "line_kind": "nonblank_lines",
      "max_lines": 25000
    }
  }
}
