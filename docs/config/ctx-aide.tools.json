{
  "config_version": 1,
  "global": {
    "allow": [
      "tool.ctxa",
      "tool.semble",
      "tool.shell",
      "tool.playwright",
      "tool.codex-security",
      "skill.ctx-aide",
      "skill.agent-native-cli-design",
      "skill.playwright",
      "skill.security-best-practices"
    ],
    "deny": [
      "app.gmail",
      "app.google-calendar",
      "app.google-drive",
      "app.vercel",
      "tool.computer-use"
    ]
  },
  "workflows": {
    "workflow.browser-validation": {
      "allow": [
        "tool.chrome-devtools",
        "tool.playwright",
        "skill.playwright"
      ],
      "deny": [
        "tool.computer-use"
      ],
      "steps": {
        "browser-smoke": {
          "allow": [
            "tool.playwright",
            "tool.chrome-devtools",
            "skill.playwright"
          ],
          "deny": [
            "tool.computer-use"
          ]
        },
        "credential-import": {
          "allow": [
            "tool.ctxa"
          ],
          "deny": [
            "app.gmail",
            "app.google-drive",
            "tool.computer-use"
          ]
        }
      }
    },
    "workflow.pull-request-review": {
      "allow": [
        "tool.ctxa",
        "tool.semble",
        "tool.shell"
      ],
      "deny": [
        "app.gmail",
        "app.google-calendar",
        "app.google-drive",
        "app.vercel",
        "tool.computer-use"
      ],
      "steps": {
        "pr-orient": {
          "allow": [
            "tool.ctxa",
            "tool.shell"
          ]
        },
        "pr-review": {
          "allow": [
            "tool.ctxa",
            "tool.semble",
            "tool.shell"
          ]
        },
        "pr-comment": {
          "allow": [
            "tool.shell"
          ]
        },
        "pr-fix": {
          "allow": [
            "tool.ctxa",
            "tool.semble",
            "tool.shell"
          ]
        },
        "pr-merge": {
          "allow": [
            "tool.ctxa",
            "tool.shell"
          ]
        }
      }
    }
  },
  "capabilities": {}
}
