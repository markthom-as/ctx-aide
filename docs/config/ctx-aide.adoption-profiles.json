      "normative_spec_files": [],
      "command_policy": {
        "mode": "all",
        "allow": [],
        "feature_gated": {},
        "deny": []
      }
    },
    "vakos": {
      "config_version": 2,
      "profile": "vakos",
      "context_root": "docs/context",
      "ticket_root": "tickets",
      "ticket_layout": "flat",
      "ticket_format": "canonical-frontmatter-vakos-v1",
      "legacy_ticket_reader": "vakos-body-status-v1",
      "source_reference_mode": "repo-relative-normative-file",
      "spec_root": null,
      "pack_root": "docs/ticket-packs",
      "pack_style": "flat-markdown-file",
      "workflow_root": "docs/workflows",
      "generated_root": "docs/context/generated",
      "allow_outside_repo": false,
      "package_manager": "cargo+npm",
      "ticket_status_command": "ctxa ticket check --repo . --profile vakos --json",
      "recommended_validation": [
        "cargo fmt --all -- --check",
        "cargo test --workspace --all-targets",
        "cargo clippy --workspace --all-targets -- -D warnings",
        "npm --prefix apps/shell/ui run build",
        "nix flake check --no-write-lock-file",
        "git diff --check"
      ],
      "preserved_ticket_system": "vakOS flat root tickets with read-only legacy support",
      "normative_spec_files": [
        "PROJECT_BRIEF.md",
        "ARCHITECTURE.md",
        "ALPHA_SPEC.md",
        "MOTION_SPEC.md",
        "COMPOSITOR_SPEC.md",
        "SYSTEM_INTEGRATION_SPEC.md",
        "CTX_AIDE_SPEC.md"
      ],
      "command_policy": {
        "mode": "allowlist",
        "allow": [
          "command.manifest",
          "schema.list",
          "schema.get",
          "adoption.status",
          "adoption.bootstrap",
          "adoption.context",
          "adoption.ticket",
          "adoption.implementation-plan",
          "lint",
          "scan",
          "query",
          "impact",
          "export-agent",
          "tools.policy",
          "tools.check",
          "ticket.check",
          "pack.check",
          "settings.set"
        ],
        "feature_gated": {
          "feedback.plan": "screenshot_feedback_review_ui",
          "feedback.review": "screenshot_feedback_review_ui",
          "feedback.review-ui": "screenshot_feedback_review_ui",
          "feedback.capture": "screenshot_feedback_review_ui"
        },
        "deny": [
          "credentials.check",
          "credentials.import-browser-state",
          "dependency.audit",
          "pr.preflight"
        ]
      }
    }
  },
  "detection": [
    {
      "profile": "vakos",
      "required_paths": ["CTX_AIDE_SPEC.md", "flake.nix", "tickets"]
    },
    {
      "profile": "astrotechne-web",
      "required_paths": ["docs/domain-redesign/tickets"]
    },
    {
      "profile": "astrotechne-engine",
      "basename_includes": "astrotechne",
      "required_paths": ["Cargo.toml"]
    },
    {
      "profile": "wetware",
      "basename_includes": "wetware",
      "required_paths": []
    }
  ]
}
