    "astrotechne-web": {
      "config_version": 2,
      "profile": "astrotechne-web",
      "context_root": "docs/context",
      "ticket_root": "docs/domain-redesign/tickets",
      "ticket_layout": "pack-directories",
      "ticket_format": "ctxa-canonical-v1",
      "legacy_ticket_reader": null,
      "source_reference_mode": "ctxa-spec-id",
      "spec_root": "docs/specs",
      "pack_root": "docs/domain-redesign/tickets",
      "pack_style": "directory-readme",
      "workflow_root": "docs/workflows",
      "generated_root": "docs/context/generated",
      "allow_outside_repo": true,
      "package_manager": "npm",
      "ticket_status_command": "npm run tickets:status",
      "recommended_validation": [
        "npm run tickets:status",
        "npx biome check",
