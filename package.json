{
  "name": "ctx-aide",
  "version": "0.1.0",
  "private": true,
  "description": "Repo-local context, markdown tickets, validation gates, and agent handoff for coding-agent workflows.",
  "type": "module",
  "bin": {
    "ctxa": "./tools/ctx-aide/ctx-aide.mjs"
  },
  "files": [
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "README.md",
    "SECURITY.md",
    "docs/config/*.json",
    "docs/config/*.md",
    "docs/context/architecture/github-public-launch-gate-2026-07-05.md",
    "docs/context/architecture/public-*.md",
    "docs/context/architecture/publication-*.md",
    "docs/context/schema/*.json",
    "docs/future-work/templates/*.md",
    "docs/specs/templates/*.md",
    "docs/ticket-packs/templates/*.md",
    "docs/tickets/templates/*.md",
    "docs/workflows/*.md",
    "examples/public-release-demo/README.md",
    "scripts/*.mjs",
    "skills/ctx-aide/**",
    "tools/ctx-aide/*.mjs"
  ],
  "keywords": [
    "ai-agents",
    "coding-agents",
    "developer-tools",
    "markdown",
    "tickets",
    "workflow",
    "local-first",
    "validation"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "install:local": "node scripts/install-local.mjs",
    "install:global": "node scripts/install-local.mjs --global",
    "test": "node tools/ctx-aide/ctx-aide.test.mjs",
    "validate": "make validate",
    "smoke": "make smoke"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
